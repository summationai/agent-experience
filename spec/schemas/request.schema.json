{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axe.dev/schemas/axe-0.1/request.schema.json",
  "type": "object",
  "properties": {
    "input": {},
    "context": {
      "type": "object",
      "properties": {
        "onBehalfOf": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "agent": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string"
            },
            "vendor": {
              "type": "string"
            },
            "contact": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "sessionId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "idempotencyKey": {
      "type": "string",
      "maxLength": 256
    }
  },
  "required": [
    "input"
  ],
  "additionalProperties": false
}
