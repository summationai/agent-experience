{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axe.dev/schemas/axe-0.1/manifest.schema.json",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "pattern": "^axe\\/\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "baseUrl": {
      "type": "string",
      "format": "uri"
    },
    "humanFallbackUrl": {
      "type": "string",
      "format": "uri"
    },
    "auth": {
      "type": "object",
      "properties": {
        "modes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "none",
              "site",
              "user"
            ]
          }
        },
        "userLoginUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "modes"
      ],
      "additionalProperties": false
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "A JSON Schema (draft 2020-12) document"
          },
          "output": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "A JSON Schema (draft 2020-12) document"
          },
          "readOnly": {
            "type": "boolean"
          },
          "idempotent": {
            "type": "boolean"
          },
          "reversible": {
            "type": "boolean"
          },
          "risk": {
            "type": "string",
            "enum": [
              "none",
              "low",
              "medium",
              "high"
            ]
          },
          "auth": {
            "type": "string",
            "enum": [
              "none",
              "site",
              "user"
            ]
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "input": {},
                "output": {}
              },
              "required": [
                "input",
                "output"
              ],
              "additionalProperties": false
            }
          },
          "display": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "list",
                  "item",
                  "table",
                  "status",
                  "document"
                ]
              },
              "items": {
                "type": "string",
                "pattern": "^(\\/([^/~]|~0|~1)*)*$",
                "description": "RFC 6901 JSON Pointer"
              },
              "item": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^(\\/([^/~]|~0|~1)*)*$",
                    "description": "RFC 6901 JSON Pointer"
                  },
                  "title": {
                    "type": "string",
                    "pattern": "^(\\/([^/~]|~0|~1)*)*$",
                    "description": "RFC 6901 JSON Pointer"
                  },
                  "subtitle": {
                    "type": "string",
                    "pattern": "^(\\/([^/~]|~0|~1)*)*$",
                    "description": "RFC 6901 JSON Pointer"
                  },
                  "summary": {
                    "type": "string",
                    "pattern": "^(\\/([^/~]|~0|~1)*)*$",
                    "description": "RFC 6901 JSON Pointer"
                  },
                  "image": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(\\/([^/~]|~0|~1)*)*$",
                        "description": "RFC 6901 JSON Pointer"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^(\\/([^/~]|~0|~1)*)*$",
                          "description": "RFC 6901 JSON Pointer"
                        }
                      }
                    ]
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^(\\/([^/~]|~0|~1)*)*$",
                    "description": "RFC 6901 JSON Pointer"
                  },
                  "price": {
                    "type": "object",
                    "properties": {
                      "amount": {
                        "type": "string",
                        "pattern": "^(\\/([^/~]|~0|~1)*)*$",
                        "description": "RFC 6901 JSON Pointer"
                      },
                      "currency": {
                        "type": "string"
                      },
                      "period": {
                        "type": "string",
                        "enum": [
                          "once",
                          "hour",
                          "day",
                          "month",
                          "year"
                        ]
                      }
                    },
                    "required": [
                      "amount",
                      "currency"
                    ],
                    "additionalProperties": false
                  },
                  "attributes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "path": {
                          "type": "string",
                          "pattern": "^(\\/([^/~]|~0|~1)*)*$",
                          "description": "RFC 6901 JSON Pointer"
                        },
                        "format": {
                          "type": "string",
                          "enum": [
                            "text",
                            "number",
                            "currency",
                            "date",
                            "datetime",
                            "boolean",
                            "area",
                            "distance",
                            "duration",
                            "list"
                          ]
                        },
                        "compare": {
                          "type": "string",
                          "enum": [
                            "higher-better",
                            "lower-better",
                            "neutral"
                          ]
                        }
                      },
                      "required": [
                        "label",
                        "path"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "badges": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^(\\/([^/~]|~0|~1)*)*$",
                      "description": "RFC 6901 JSON Pointer"
                    }
                  }
                },
                "required": [
                  "id",
                  "title"
                ],
                "additionalProperties": false
              },
              "suggestedComparison": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "emptyMessage": {
                "type": "string"
              },
              "disclaimer": {
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          "affordances": {
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "input": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^(\\/([^/~]|~0|~1)*)*$",
                    "description": "RFC 6901 JSON Pointer"
                  }
                },
                "primary": {
                  "type": "boolean"
                }
              },
              "required": [
                "action",
                "title",
                "input"
              ],
              "additionalProperties": false
            }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "cursorIn": {
                "type": "string",
                "pattern": "^(\\/([^/~]|~0|~1)*)*$",
                "description": "RFC 6901 JSON Pointer"
              },
              "cursorOut": {
                "type": "string",
                "pattern": "^(\\/([^/~]|~0|~1)*)*$",
                "description": "RFC 6901 JSON Pointer"
              },
              "pageSize": {
                "type": "object",
                "properties": {
                  "default": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "default",
                  "max"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "cursorIn",
              "cursorOut",
              "pageSize"
            ],
            "additionalProperties": false
          },
          "freshness": {
            "type": "object",
            "properties": {
              "cacheTtlSeconds": {
                "type": "number",
                "minimum": 0
              },
              "validUntil": {
                "type": "string",
                "pattern": "^(\\/([^/~]|~0|~1)*)*$",
                "description": "RFC 6901 JSON Pointer"
              }
            },
            "additionalProperties": false
          },
          "humanHandoff": {
            "type": "object",
            "properties": {
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "reasons"
            ],
            "additionalProperties": false
          },
          "deprecated": {
            "type": "object",
            "properties": {
              "since": {
                "type": "string"
              },
              "replacedBy": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
              }
            },
            "required": [
              "since"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "title",
          "description",
          "input",
          "output",
          "readOnly",
          "idempotent",
          "reversible",
          "risk",
          "auth"
        ],
        "additionalProperties": false
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
            }
          }
        },
        "required": [
          "name",
          "title",
          "description",
          "steps"
        ],
        "additionalProperties": false
      }
    },
    "policies": {
      "type": "object",
      "properties": {
        "rateLimit": {
          "type": "object",
          "properties": {
            "requestsPerMinute": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "burst": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "requestsPerMinute"
          ],
          "additionalProperties": false
        },
        "termsUrl": {
          "type": "string",
          "format": "uri"
        },
        "dataRetention": {
          "type": "string"
        },
        "agents": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deny": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "contact": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "brand": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "logoUrl": {
          "type": "string",
          "format": "uri"
        },
        "accentColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{3,8}$"
        },
        "tone": {
          "type": "string",
          "enum": [
            "formal",
            "neutral",
            "casual"
          ]
        }
      },
      "additionalProperties": false
    },
    "indexUrl": {
      "type": "string",
      "format": "uri"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "protocol",
    "name",
    "description",
    "baseUrl",
    "auth",
    "actions"
  ],
  "additionalProperties": false
}
