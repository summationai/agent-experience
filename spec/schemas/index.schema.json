{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axe.dev/schemas/axe-0.1/index.schema.json",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "pattern": "^axe\\/\\d+\\.\\d+$"
    },
    "platform": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "additionalProperties": false
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "manifestUrl": {
            "type": "string",
            "format": "uri"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "manifestUrl",
          "updatedAt"
        ],
        "additionalProperties": false
      }
    },
    "next": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "protocol",
    "platform",
    "sites"
  ],
  "additionalProperties": false
}
