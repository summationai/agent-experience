{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axe.dev/schemas/axe-0.1/state.schema.json",
  "type": "object",
  "properties": {
    "rev": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "number"
        }
      ]
    },
    "actions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "available": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "available"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "available": {
                "type": "boolean",
                "const": false
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "requires": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "pattern": "^(payment|identity|document|contact|consent)\\.[a-z][a-z0-9-]*$|^x-[a-z0-9]+(-[a-z0-9]+)*\\.[a-z][a-z0-9-]*$"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "schema": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {},
                      "description": "A JSON Schema (draft 2020-12) document"
                    },
                    "sensitive": {
                      "type": "boolean"
                    },
                    "instructions": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "title",
                    "description",
                    "schema",
                    "sensitive"
                  ],
                  "additionalProperties": false
                }
              },
              "handoff": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "instructions": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "whatAgentShouldSayToUser": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "reason",
                  "instructions",
                  "url",
                  "whatAgentShouldSayToUser"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "available",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "actions"
  ],
  "additionalProperties": false
}
