{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axe.dev/schemas/axe-0.1/kinds/contact.phone.schema.json",
  "title": "Phone number",
  "description": "A phone number for the user in E.164 form. Kind: contact.phone. Sensitive: false.",
  "type": "object",
  "properties": {
    "phone": {
      "type": "string",
      "pattern": "^\\+[1-9][0-9]{6,14}$",
      "description": "E.164, e.g. +14255550100"
    },
    "canReceiveSms": {
      "type": "boolean"
    }
  },
  "required": [
    "phone"
  ],
  "additionalProperties": false
}
