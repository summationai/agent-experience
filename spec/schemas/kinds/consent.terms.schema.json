{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axe.dev/schemas/axe-0.1/kinds/consent.terms.schema.json",
  "title": "Consent to terms",
  "description": "Acknowledgment of one specific policy version for one specific scope. Kind: consent.terms. Sensitive: false.",
  "type": "object",
  "properties": {
    "policyUrl": {
      "type": "string",
      "format": "uri"
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1,
      "description": "Exact version identifier or date"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "What the consent covers"
    },
    "acceptedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "acceptedBy": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "policyUrl",
    "policyVersion",
    "scope",
    "acceptedAt"
  ],
  "additionalProperties": false
}
