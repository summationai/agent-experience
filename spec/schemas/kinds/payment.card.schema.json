{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axe.dev/schemas/axe-0.1/kinds/payment.card.schema.json",
  "title": "Payment card",
  "description": "A tokenized payment card from the agent's wallet. Kind: payment.card. Sensitive: true.",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "minLength": 1,
      "description": "PSP-issued single-use or network token"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "description": "Payment service provider, e.g. stripe"
    },
    "brand": {
      "description": "Card network, lowercase",
      "type": "string",
      "minLength": 1
    },
    "last4": {
      "type": "string",
      "pattern": "^[0-9]{4}$"
    },
    "expMonth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "expYear": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2100
    },
    "billingPostalCode": {
      "type": "string",
      "minLength": 1
    },
    "amount": {
      "type": "number",
      "minimum": 0,
      "description": "Amount in major units"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency code, e.g. USD"
    }
  },
  "required": [
    "token",
    "provider"
  ],
  "additionalProperties": false
}
