{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axe.dev/schemas/axe-0.1/kinds/identity.government-id.schema.json",
  "title": "Government-issued ID",
  "description": "Details from a passport, driver's license, national ID, or residence permit. Kind: identity.government-id. Sensitive: true.",
  "type": "object",
  "properties": {
    "documentType": {
      "type": "string",
      "enum": [
        "passport",
        "drivers-license",
        "national-id",
        "residence-permit"
      ]
    },
    "documentNumber": {
      "type": "string",
      "minLength": 1
    },
    "issuingCountry": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2 country code"
    },
    "fullName": {
      "type": "string",
      "minLength": 1,
      "description": "Name as printed on the document"
    },
    "dateOfBirth": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "expiresOn": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    }
  },
  "required": [
    "documentType",
    "documentNumber",
    "issuingCountry",
    "fullName"
  ],
  "additionalProperties": false
}
