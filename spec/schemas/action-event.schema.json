{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axe.dev/schemas/axe-0.1/action-event.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "action": {
      "type": "string"
    },
    "event": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "needs_input",
        "needs_human",
        "pending",
        "error"
      ]
    },
    "errorCode": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "invalid_input",
            "unauthorized",
            "forbidden",
            "not_found",
            "conflict",
            "rate_limited",
            "unavailable",
            "internal",
            "unsupported"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "actor": {
      "type": [
        "string",
        "null"
      ]
    },
    "details": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "tenant": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "ts",
    "action",
    "event",
    "status",
    "errorCode",
    "actor",
    "details",
    "tenant"
  ],
  "additionalProperties": false
}
