auto-install-peers=true
strict-peer-dependencies=false
# @summationai/* lives in GitHub Packages (see docs/deploying.md). No auth line here: the
# workspace installs its own packages from the workspace, and a ${NODE_AUTH_TOKEN} reference
# fails installs wherever it is unset. The release job's setup-node supplies the token.
@summationai:registry=https://npm.pkg.github.com
