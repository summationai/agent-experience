{
  "name": "@summationai/axe-surface",
  "version": "0.1.0",
  "description": "Surface: an application's registry of its own live controls, observed and acted on under one revision, with AXE risk metadata, kinds, and result envelopes.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./axe": {
      "import": {
        "types": "./dist/axe.d.ts",
        "default": "./dist/axe.js"
      },
      "require": {
        "types": "./dist/axe.d.cts",
        "default": "./dist/axe.cjs"
      }
    },
    "./webmcp": {
      "import": {
        "types": "./dist/webmcp.d.ts",
        "default": "./dist/webmcp.js"
      },
      "require": {
        "types": "./dist/webmcp.d.cts",
        "default": "./dist/webmcp.cjs"
      }
    },
    "./auto": {
      "import": {
        "types": "./dist/auto.d.ts",
        "default": "./dist/auto.js"
      },
      "require": {
        "types": "./dist/auto.d.cts",
        "default": "./dist/auto.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ],
      "axe": [
        "./dist/axe.d.ts"
      ],
      "webmcp": [
        "./dist/webmcp.d.ts"
      ],
      "auto": [
        "./dist/auto.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "test:browser": "node test/browser/run.mjs"
  },
  "dependencies": {
    "@summationai/axe-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@summationai/axe-testing": "workspace:*",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.12",
    "jsdom": "^30.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/summationai/agent-experience",
    "directory": "packages/surface"
  },
  "keywords": [
    "axe",
    "agents",
    "ai",
    "surface",
    "live-state"
  ]
}
