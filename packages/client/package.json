{
  "name": "@summationai/axe-client",
  "version": "1.1.0",
  "description": "Agent-side client for AXE: discover, invoke, continue, resume, and present results.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./present": {
      "import": {
        "types": "./dist/present.d.ts",
        "default": "./dist/present.js"
      },
      "require": {
        "types": "./dist/present.d.cts",
        "default": "./dist/present.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@summationai/axe-core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/summationai/agent-experience",
    "directory": "packages/client"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "keywords": [
    "axe",
    "agents",
    "ai",
    "protocol"
  ],
  "typesVersions": {
    "*": {
      "present": [
        "./dist/present.d.ts"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
