+// Agent Surface for this app, written by `axe surface init`. Yours to edit.
+//
+// <AgentSurface> wraps the app root. On, autoSurface discovers the controls under it and, in
+// development, publishes window.__surface for `axe surface coverage` and browser agents.
+// It also registers the live controls with a browser-native agent when WebMCP is available.
+// Off, it renders its children and nothing else. Overlay config: ./surface.config.
+// Nothing here runs at import time: the provider starts discovery and the remote connection in an effect,
+// so a server render renders the children only.
+//
+// Always on: Surface is a browser-local description of controls, not a separately deployed service.
+// Always on after a provider browser handoff or in an optional `axe host` session (both are read by
+// `injectedRelay()`).
+import type { ReactNode } from "react";
+import { SurfaceProvider } from "@summationai/axe-surface/react";
+import { connectRelay, injectedRelay } from "@summationai/axe-relay/client";
+import surfaceConfig from "./surface.config";
+
+const development = import.meta.env.DEV;
+const enabled = true;
+
+// The relay carries the page's surface to an agent outside the browser (an MCP client). The
+// provider supplies a scoped connection through its browser handoff or optional host;
+// anywhere else nothing connects. `axe surface init --relay-dev` adds the development relay
+// for a person's own tab (attended mode, with pairing).
+
+export function AgentSurface({ children }: { children: ReactNode }) {
+  return (
+    <SurfaceProvider
+      config={surfaceConfig}
+      flag={enabled}
+      expose={development}
+      webMcp
+      onReady={(handle) => {
+        const options = injectedRelay();
+        if (!options) return;
+        const connection = connectRelay(handle.surface, options);
+        return () => connection.disconnect();
+      }}
+    >
+      {children}
+    </SurfaceProvider>
+  );
+}
