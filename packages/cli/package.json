{
  "name": "@summationai/axe",
  "version": "1.1.0",
  "description": "Command-line tool for AXE and Surface: init, validate, inspect, preview, conformance, audit, mcp, generate, relay, host, surface init, surface coverage.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@summationai/axe-core": "workspace:*",
    "@summationai/axe-client": "workspace:*",
    "@summationai/axe-mcp": "workspace:*",
    "@summationai/axe-testing": "workspace:*",
    "tsx": "^4.23.15",
    "@summationai/axe-generate": "workspace:*",
    "@summationai/axe-relay": "workspace:*",
    "@summationai/axe-host": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/summationai/agent-experience",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "keywords": [
    "axe",
    "agents",
    "ai",
    "protocol"
  ],
  "bin": {
    "axe": "./dist/index.js"
  },
  "devDependencies": {
    "@summationai/axe-express": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.1"
  }
}
