{
  "name": "@summationai/axe-core",
  "version": "0.1.0",
  "description": "AXE protocol types, schemas, well-known kinds, and framework-free server runtime.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vocabulary": {
      "import": {
        "types": "./dist/vocabulary.d.ts",
        "default": "./dist/vocabulary.js"
      },
      "require": {
        "types": "./dist/vocabulary.d.cts",
        "default": "./dist/vocabulary.cjs"
      }
    },
    "./kinds": {
      "import": {
        "types": "./dist/kinds.d.ts",
        "default": "./dist/kinds.js"
      },
      "require": {
        "types": "./dist/kinds.d.cts",
        "default": "./dist/kinds.cjs"
      }
    },
    "./events": {
      "import": {
        "types": "./dist/events.d.ts",
        "default": "./dist/events.js"
      },
      "require": {
        "types": "./dist/events.d.cts",
        "default": "./dist/events.cjs"
      }
    },
    "./display": {
      "import": {
        "types": "./dist/display.d.ts",
        "default": "./dist/display.js"
      },
      "require": {
        "types": "./dist/display.d.cts",
        "default": "./dist/display.cjs"
      }
    },
    "./lint": {
      "import": {
        "types": "./dist/lint.d.ts",
        "default": "./dist/lint.js"
      },
      "require": {
        "types": "./dist/lint.d.cts",
        "default": "./dist/lint.cjs"
      }
    },
    "./schemas": {
      "import": {
        "types": "./dist/schemas.d.ts",
        "default": "./dist/schemas.js"
      },
      "require": {
        "types": "./dist/schemas.d.cts",
        "default": "./dist/schemas.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    },
    "./json-schema": {
      "import": {
        "types": "./dist/json-schema.d.ts",
        "default": "./dist/json-schema.js"
      },
      "require": {
        "types": "./dist/json-schema.d.cts",
        "default": "./dist/json-schema.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/summationai/agent-experience",
    "directory": "packages/core"
  },
  "keywords": [
    "axe",
    "agents",
    "ai",
    "protocol"
  ],
  "typesVersions": {
    "*": {
      "vocabulary": [
        "./dist/vocabulary.d.ts"
      ],
      "kinds": [
        "./dist/kinds.d.ts"
      ],
      "events": [
        "./dist/events.d.ts"
      ],
      "display": [
        "./dist/display.d.ts"
      ],
      "lint": [
        "./dist/lint.d.ts"
      ],
      "schemas": [
        "./dist/schemas.d.ts"
      ],
      "types": [
        "./dist/types.d.ts"
      ],
      "json-schema": [
        "./dist/json-schema.d.ts"
      ],
      "node": [
        "./dist/node.d.ts"
      ]
    }
  }
}
