{
  "name": "@summationai/axe-mcp",
  "version": "1.0.0",
  "description": "Derive a Model Context Protocol server from any AXE manifest or server.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@summationai/axe-client": "workspace:*",
    "@summationai/axe-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/summationai/agent-experience",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "keywords": [
    "axe",
    "agents",
    "ai",
    "protocol"
  ],
  "devDependencies": {
    "jsdom": "^30.1.1"
  }
}
