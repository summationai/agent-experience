{
  "name": "plan-review-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Reference application: a demand plan edited by people and agents, approved by a person. Server actions over AXE; browser-local controls on the page.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build:app": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:app": "next build && playwright test",
    "eval": "next build && node --import tsx eval/run.ts",
    "eval:model": "node --import tsx eval/model/run.ts"
  },
  "dependencies": {
    "@summationai/axe-core": "workspace:*",
    "@summationai/axe-next": "workspace:*",
    "@summationai/axe-surface": "workspace:*",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@summationai/axe-client": "workspace:*",
    "@summationai/axe-mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@playwright/test": "1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
