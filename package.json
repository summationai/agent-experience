{
  "name": "body-spray",
  "private": true,
  "version": "0.0.0",
  "description": "AXE: an open, HTTP-native protocol and TypeScript SDK for exposing an agent-specific interface alongside a website.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "clean": "turbo run clean && rm -rf node_modules/.cache",
    "gen:vocabulary": "node scripts/gen-vocabulary.mjs",
    "gen:schemas": "node scripts/gen-schemas.mjs",
    "gen:snippets": "node scripts/include-snippets.mjs",
    "check:snippets": "node scripts/include-snippets.mjs --check",
    "docs:api": "typedoc",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "turbo": "^2.11.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
