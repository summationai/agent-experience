# Local development only. The service binds to loopback and still requires a pairing code.
AXE_MCP_HOST=127.0.0.1
AXE_MCP_PORT=4717
AXE_MCP_AGENT_KEY=axd_agent_experience_local
# Optional comma-separated exact origins or localhost wildcard patterns.
# AXE_MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Laptop-only unattended mode: the agent operates a hidden browser, including login and tenant
# selection when those pages mount the injected-only Surface. Both the app and listener are forced
# to loopback. This validates the no-visible-browser product shape; never deploy this dev mode.
# AXE_MCP_MODE=local-unattended
# HOST=127.0.0.1
# PORT=4717
# AXE_HOST_APP_URL=http://localhost:5173/login
# AXE_HOST_START_PATH=/login
# AXE_MCP_AGENT_KEY=axd_agent_experience_local
# Optional: reuse a session captured by `axe host login` instead of signing in through Surface.
# AXE_HOST_STATE_PATH=.axe/summation-state.json
# Optional when Playwright's installed Chromium is not available.
# AXE_HOST_BROWSER_EXECUTABLE_PATH=/absolute/path/to/chromium
# AXE_HOST_DEV_PRINCIPAL=local-user
# AXE_HOST_DEV_TENANT=unselected

# Provider-operated browser-handoff mode (recommended). The consuming app installs the browser
# package but adds no backend endpoint, shared secret, or session broker.
# AXE_MCP_MODE=handoff
# HOST=0.0.0.0
# PORT=8080
# AXE_HOST_APP_URL=https://app.customer.example
# AXE_HOST_PUBLIC_MCP_URL=https://agents.provider.example/mcp
# AXE_HOST_AUTH_MODE=oauth
# AXE_HOST_AUTHORIZATION_SERVERS=https://auth.provider.example
# AXE_HOST_SCOPES=surface:act
# AXE_HOST_OAUTH_INTROSPECTION_URL=https://auth.provider.example/oauth/introspect
# AXE_HOST_OAUTH_CLIENT_ID=agent-experience-resource-server
# AXE_HOST_OAUTH_CLIENT_SECRET=replace-me
# Alternative for application-issued opaque OAuth tokens: validate them through an authenticated
# identity endpoint. Claims may use dotted paths into its JSON response.
# AXE_HOST_OAUTH_USERINFO_URL=https://api.customer.example/v1/me
# AXE_HOST_PRINCIPAL_CLAIM=identity.user_id
# AXE_HOST_TENANT_CLAIM=identity.org_id
# AXE_HOST_DEFAULT_TENANT=single-tenant-app
# AXE_HOST_ALLOWED_ORIGINS=https://app.customer.example

# Laptop-only browser handoff: open the local application's own sign-in page, with no OAuth
# issuer. All three addresses must be loopback; never deploy this mode or expose it on a LAN.
# AXE_HOST_AUTH_MODE=local
# HOST=127.0.0.1
# AXE_HOST_APP_URL=http://localhost:5173/login
# AXE_HOST_PUBLIC_MCP_URL=http://127.0.0.1:4717/mcp

# Production unattended-browser mode. The browser remains invisible to the end user. Today this
# requires an application session broker; the provider-owned account/session service can satisfy
# that boundary later without changing the customer's browser package integration.
# AXE_MCP_MODE=hosted
# AXE_HOST_START_PATH=/
# AXE_HOST_SESSION_BROKER_URL=https://app.customer.example/internal/agent-session
# "service" (default) authenticates with the provider secret below. "caller" forwards the already
# verified OAuth bearer to the issuing application's own session-exchange endpoint.
# AXE_HOST_SESSION_BROKER_AUTH=service
# AXE_HOST_SESSION_BROKER_TOKEN=replace-me
# AXE_HOST_PRINCIPAL_CLAIM=sub
# AXE_HOST_TENANT_CLAIM=org
# AXE_HOST_MAX_SESSIONS=50
# AXE_HOST_IDLE_MS=600000
